<%# Solución Módulo 04 — Ejercicio 2: partial con colección %>
<%# app/views/tasks/_task.html.erb %>
<%# Se invoca con: <%= render @tasks %> — Rails resuelve _task.html.erb automáticamente. %>

<%= turbo_frame_tag dom_id(task) do %>
  <article class="task <%= "task--done" if task.completed? %>">
    <span class="task__status">
      <%= task.completed? ? "✓" : "○" %>
    </span>

    <%= link_to task.title, task_path(task), class: "task__title" %>

    <% if task.deadline.present? %>
      <small class="task__deadline">
        Vence: <%= l(task.deadline, format: :short) %>
      </small>
    <% end %>

    <div class="task__actions">
      <%= link_to "Editar", edit_task_path(task) %>
      <%= button_to "Eliminar", task_path(task), method: :delete,
            data: { turbo_confirm: "¿Eliminar la tarea?" } %>
    </div>
  </article>
<% end %>
